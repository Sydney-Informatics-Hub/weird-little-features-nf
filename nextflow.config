// =================================================================
//
// nextflow.config is the main configuration script for a nextflow pipeline
// Should contain the following sections:
    // A manifest for defining workflow metadata
    // Mandated minimal version of Nextflow required to run pipeline
    // Default workflow parameter definitions
    // Shell behaviour settings for the workflow
    // Execution reports
    // Configuration profiles

// Examples are included for each section. Remove them and replace
// with project-specific code. For more information see:
// https://www.nextflow.io/docs/latest/index.html.
//
// ===================================================================

// Define some metadata for publishing pipeline on GitHub
// See https://docs.seqera.io/nextflow
manifest {
    contributors = [
        [
            name:'Georgie Samaha',
            affiliation:'Sydney Informatics Hub',
            email:'georgiesamaha@gmail.com',
            github:'https://github.com/georgiesamaha',
            contribution:['author'],
            orcid:''
        ]
    ]
    name = 'Weird-little-features-nf'
    description = 'Repeat expansion, MEI, and de novo repeat discovery from short-read Illumina BAM files (human and non-human mammals).'
    homePage = 'https://github.com/Sydney-Informatics-Hub/Weird-little-features-nf'
    nextflowVersion = '!>=24'
}

// Set default workflow parameters
// See https://www.nextflow.io/docs/latest/config.html#scope-params
params {
    help        = false
    input       = false
    outdir      = 'results'
    timestamp   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Reference
    ref         = false   // FASTA; .fai must exist alongside

    // Repeat expansion tools (ExpansionHunter + GangSTR)
    // No standard catalogs exist for non-human species — these steps are
    // skipped when the param is unset.
    catalog     = false   // ExpansionHunter variant catalog (JSON)
    ref_str     = false   // GangSTR STR region file (TSV/BED)

    // MEI detection (xTEa)
    // The bundled library is human-specific; non-human requires a custom lib.
    xtea_lib    = false   // xTEa repeat library directory

    // Annotation
    vep_cache   = false   // VEP cache directory (human samples)
    snpeff_db   = false   // SnpEff database name (non-human samples)

    // HPC scratch for temp I/O — important on Lustre (Gadi)
    scratch     = System.getenv('TMPDIR') ?: '/tmp'
}

// Fail a task if any command returns non-zero exit code
// See https://www.nextflow.io/docs/latest/process.html#script
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Include modules.config
includeConfig "config/modules.config"

// Produce a workflow diagram
// See https://www.nextflow.io/docs/latest/tracing.html#dag-visualisation
dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/runInfo/dag.${params.timestamp}.svg"
}

// Output resource and runtime reports for a workflow run
// See https://www.nextflow.io/docs/latest/tracing.html
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/runInfo/report.${params.timestamp}.html"
}

// Output an html timeline report
// See https://www.nextflow.io/docs/latest/tracing.html#timeline-report
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/runInfo/timeline.${params.timestamp}.html"
}

// Output process execution trace file
// See https://www.nextflow.io/docs/latest/tracing.html#trace-report
trace {
    enabled = true
    overwrite = false
    file = "${params.outdir}/run_info/trace.${params.timestamp}.txt"
    fields = 'name,task_id,hash,workdir,status,exit,duration,realtime,cpus,%cpu,memory,%mem,peak_rss'
}

// Enable profiles for different compute infrastructures or set up
// See https://www.nextflow.io/docs/latest/config.html#config-profiles
profiles {
    test        { includeConfig "config/test.config" }
    gadi        { includeConfig "config/gadi.config" }
    setonix     { includeConfig "config/setonix.config" }
    singularity {
        enabled     = true
        autoMounts  = true
    }
}