// Test profile — overrides resource limits for local stub/preview runs
// Not intended for real analysis; use -profile gadi for HPC execution.

params {
    input    = "${projectDir}/test_data/test_samplesheet.csv"
    ref      = "/scratch/er01/gs5517/tests/Parabricks-Genomics-nf/test_data/test_chr21.fa"
    catalog  = "${projectDir}/test_data/test_catalog.json"
    outdir   = "results/test"
}

process {
    cpus   = 2
    memory = 4.GB

    withLabel: 'small_job'  { cpus = 1; memory = 1.GB }
    withLabel: 'medium_job' { cpus = 2; memory = 4.GB }
    withLabel: 'cpu_job'    { cpus = 2; memory = 4.GB }

    withName: 'EXPANSIONHUNTER' { cpus = 2; memory = 4.GB }
    withName: 'GANGSTR'         { cpus = 2; memory = 4.GB }
    withName: 'STRANGER'        { cpus = 1; memory = 1.GB }
}
