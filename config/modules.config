// The modules.config file is for specifying module/process-specific resource requirements

process {
    // Default resources
    cpus   = 1
    memory = 4.GB

    // ---------------------------------------------------------------
    // Labels
    // ---------------------------------------------------------------
    withLabel: 'small_job' {
        cpus   = 1
        memory = 4.GB
    }

    withLabel: 'medium_job' {
        cpus   = 4
        memory = 16.GB
    }

    withLabel: 'cpu_job' {
        cpus   = 8
        memory = 32.GB
    }

    // ---------------------------------------------------------------
    // Repeat expansion modules
    // ---------------------------------------------------------------
    withName: 'EXPANSIONHUNTER' {
        cpus   = 4
        memory = 16.GB
    }

    withName: 'GANGSTR' {
        cpus   = 4
        memory = 16.GB
    }

    withName: 'STRANGER' {
        cpus   = 1
        memory = 4.GB
    }

    // ---------------------------------------------------------------
    // MEI detection modules
    // ---------------------------------------------------------------
    withName: 'XTEA' {
        cpus   = 8
        memory = 32.GB
    }

    withName: 'NUMT_DETECT' {
        cpus   = 2
        memory = 8.GB
    }

    // ---------------------------------------------------------------
    // De novo repeat discovery modules
    // ---------------------------------------------------------------
    withName: 'STRLING_GENOME' {
        cpus   = 4
        memory = 16.GB
    }

    withName: 'STRLING_OUTLIERS' {
        cpus   = 1
        memory = 8.GB
    }

    // ---------------------------------------------------------------
    // Annotation modules
    // ---------------------------------------------------------------
    withName: 'VEP' {
        cpus   = 4
        memory = 16.GB
    }

    withName: 'SNPEFF' {
        cpus   = 2
        memory = 8.GB
    }

    withName: 'LIFTOVER' {
        cpus   = 1
        memory = 4.GB
    }
}
